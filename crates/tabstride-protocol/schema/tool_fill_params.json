{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FillParams",
  "type": "object",
  "required": [
    "session_id",
    "target",
    "value"
  ],
  "properties": {
    "clear_before": {
      "description": "Clear the field before typing. Defaults to `true`; pass `false` to append instead of replacing.",
      "type": [
        "boolean",
        "null"
      ]
    },
    "page_update": {
      "anyOf": [
        {
          "$ref": "#/definitions/PageUpdateMode"
        },
        {
          "type": "null"
        }
      ]
    },
    "session_id": {
      "type": "string"
    },
    "tab_id": {
      "type": [
        "integer",
        "null"
      ],
      "format": "int64"
    },
    "target": {
      "$ref": "#/definitions/Locator"
    },
    "timeout_ms": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 1.0
    },
    "value": {
      "type": "string"
    }
  },
  "definitions": {
    "Locator": {
      "description": "Unified element locator used by CLI, Flow, and extension interaction tools. Exactly one primary strategy must be present. `role` additionally requires `name`; `exact` applies to semantic string strategies only.",
      "type": "object",
      "properties": {
        "css": {
          "type": [
            "string",
            "null"
          ]
        },
        "exact": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "placeholder": {
          "type": [
            "string",
            "null"
          ]
        },
        "ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "type": [
            "string",
            "null"
          ]
        },
        "testId": {
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "PageUpdateMode": {
      "description": "Amount of page-state information requested after an interaction.",
      "oneOf": [
        {
          "description": "Skip document identity reads and Snapshot work.",
          "type": "string",
          "enum": [
            "none"
          ]
        },
        {
          "description": "Return only the lightweight changed/unchanged/unknown signal.",
          "type": "string",
          "enum": [
            "signal"
          ]
        },
        {
          "description": "Return a Snapshot delta when a compatible baseline exists.",
          "type": "string",
          "enum": [
            "delta"
          ]
        }
      ]
    }
  }
}
