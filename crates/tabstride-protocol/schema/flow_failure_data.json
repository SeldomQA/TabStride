{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FlowFailureData",
  "type": "object",
  "required": [
    "cause",
    "completed_steps",
    "duration_ms",
    "failed_method",
    "failed_step",
    "flow_name"
  ],
  "properties": {
    "cause": {
      "$ref": "#/definitions/RpcError"
    },
    "completed_steps": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/FlowStepResult"
      }
    },
    "duration_ms": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "failed_method": {
      "type": "string"
    },
    "failed_step": {
      "type": "integer",
      "format": "uint",
      "minimum": 0.0
    },
    "failed_step_result": {
      "description": "Result metadata for the step that failed after execution started. Validation failures or cancellation before dispatch leave this absent.",
      "anyOf": [
        {
          "$ref": "#/definitions/FlowStepResult"
        },
        {
          "type": "null"
        }
      ]
    },
    "flow_name": {
      "type": "string"
    }
  },
  "definitions": {
    "ErrorCode": {
      "description": "Stable daemon/extension error codes (§4.5).",
      "type": "string",
      "enum": [
        "unknown_method",
        "unsupported",
        "invalid_params",
        "not_found",
        "ambiguous_target",
        "permission_denied",
        "timeout",
        "cdp_failed",
        "protocol_error",
        "cancelled",
        "user_aborted",
        "version_too_old",
        "multiple_browsers_online",
        "no_browser_connected"
      ]
    },
    "FlowStepResult": {
      "type": "object",
      "required": [
        "duration_ms",
        "index",
        "method",
        "output"
      ],
      "properties": {
        "duration_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "index": {
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "method": {
          "type": "string"
        },
        "output": true,
        "timing": {
          "description": "Full-chain timing breakdown for this step.",
          "anyOf": [
            {
              "$ref": "#/definitions/StepTiming"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "RpcError": {
      "description": "Wire-format JSON-RPC error object carried inside [`crate::frame::ResponseFrame`].",
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "$ref": "#/definitions/ErrorCode"
        },
        "data": true,
        "message": {
          "type": "string"
        }
      }
    },
    "StepTiming": {
      "description": "Per-step timing phase breakdown (all values in microseconds).",
      "type": "object",
      "properties": {
        "cdp_span_us": {
          "description": "First CDP start → last CDP finish; may include waits between commands.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "cdp_us": {
          "description": "Sum of each individual CDP command execution inside the extension.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "extension_non_cdp_us": {
          "description": "Extension-side processing excluding accumulated CDP command time.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "extension_us": {
          "description": "Total extension-side processing (receive → reply), including CDP.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "local_us": {
          "description": "Daemon-observed execution time when the step is local (such as `wait_ms`) or cancellation wins before transport phase Timing returns.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "queue_us": {
          "description": "Time waiting in the per-session dispatch queue.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "websocket_roundtrip_us": {
          "description": "Daemon send → daemon response receive, including extension execution.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "websocket_us": {
          "description": "WebSocket transport in both directions, excluding extension execution.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        }
      }
    }
  }
}
