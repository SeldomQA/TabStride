{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AssertResult",
  "type": "object",
  "required": [
    "actual",
    "assertion",
    "elapsed_ms",
    "expected",
    "match_count",
    "passed",
    "tab_id"
  ],
  "properties": {
    "actual": true,
    "assertion": {
      "type": "string"
    },
    "elapsed_ms": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "expected": true,
    "match_count": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "passed": {
      "type": "boolean"
    },
    "tab_id": {
      "type": "integer",
      "format": "int64"
    },
    "used_target": {
      "anyOf": [
        {
          "$ref": "#/definitions/Locator"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "definitions": {
    "Locator": {
      "description": "Unified element locator used by CLI, Flow, and extension interaction tools. Exactly one primary strategy must be present. `role` additionally requires `name`; `exact` applies to semantic string strategies only.",
      "type": "object",
      "properties": {
        "css": {
          "type": [
            "string",
            "null"
          ]
        },
        "exact": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "placeholder": {
          "type": [
            "string",
            "null"
          ]
        },
        "ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "type": [
            "string",
            "null"
          ]
        },
        "testId": {
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
