{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Locator",
  "description": "Unified element locator used by CLI, Flow, and extension interaction tools. Exactly one primary strategy must be present. `role` additionally requires `name`; `exact` applies to semantic string strategies only.",
  "type": "object",
  "properties": {
    "css": {
      "type": [
        "string",
        "null"
      ]
    },
    "exact": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "label": {
      "type": [
        "string",
        "null"
      ]
    },
    "name": {
      "type": [
        "string",
        "null"
      ]
    },
    "placeholder": {
      "type": [
        "string",
        "null"
      ]
    },
    "ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "role": {
      "type": [
        "string",
        "null"
      ]
    },
    "testId": {
      "type": [
        "string",
        "null"
      ]
    },
    "text": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
