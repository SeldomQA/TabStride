{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FlowRunResult",
  "type": "object",
  "required": [
    "completed_steps",
    "duration_ms",
    "name"
  ],
  "properties": {
    "completed_steps": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/FlowStepResult"
      }
    },
    "duration_ms": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "name": {
      "type": "string"
    }
  },
  "definitions": {
    "FlowStepResult": {
      "type": "object",
      "required": [
        "duration_ms",
        "index",
        "method",
        "output"
      ],
      "properties": {
        "duration_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "index": {
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "method": {
          "type": "string"
        },
        "output": true,
        "timing": {
          "description": "Full-chain timing breakdown for this step.",
          "anyOf": [
            {
              "$ref": "#/definitions/StepTiming"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "StepTiming": {
      "description": "Per-step timing phase breakdown (all values in microseconds).",
      "type": "object",
      "properties": {
        "cdp_us": {
          "description": "CDP command execution inside the extension.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "extension_us": {
          "description": "Extension-side processing (receive → reply).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "queue_us": {
          "description": "Time waiting in the per-session dispatch queue.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "websocket_us": {
          "description": "WebSocket round-trip to the extension.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        }
      }
    }
  }
}
