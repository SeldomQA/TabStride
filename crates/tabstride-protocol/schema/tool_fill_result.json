{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FillResult",
  "type": "object",
  "required": [
    "tab_id",
    "used_target",
    "value_length"
  ],
  "properties": {
    "dialogs": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/JavaScriptDialogInfo"
      }
    },
    "document_change_known": {
      "description": "Whether `document_changed` is authoritative.",
      "default": false,
      "type": "boolean"
    },
    "document_changed": {
      "description": "Whether the page DOM changed as a result of this interaction.",
      "default": false,
      "type": "boolean"
    },
    "document_version": {
      "description": "CDP document version after the interaction.",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0.0
    },
    "snapshot_delta": {
      "anyOf": [
        {
          "$ref": "#/definitions/InteractionSnapshotDelta"
        },
        {
          "type": "null"
        }
      ]
    },
    "tab_id": {
      "type": "integer",
      "format": "int64"
    },
    "used_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "used_selector": {
      "type": [
        "string",
        "null"
      ]
    },
    "used_target": {
      "$ref": "#/definitions/Locator"
    },
    "value_length": {
      "description": "UTF-16 code-unit length of the value that was finally typed (matches what `input.value.length` would report in the page).",
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    }
  },
  "definitions": {
    "InteractionSnapshotDelta": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "base_document_version": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "document_version": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "ref_count": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "removed_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "$ref": "#/definitions/SnapshotDeltaStatus"
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "truncated": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "JavaScriptDialogHandledAction": {
      "description": "How the extension resolved the dialog so CDP could continue.",
      "type": "string",
      "enum": [
        "accepted",
        "dismissed"
      ]
    },
    "JavaScriptDialogInfo": {
      "description": "One observed + handled JavaScript dialog during a tool call.",
      "type": "object",
      "required": [
        "handled",
        "message",
        "sequence",
        "tab_id",
        "type"
      ],
      "properties": {
        "default_prompt": {
          "type": [
            "string",
            "null"
          ]
        },
        "handled": {
          "$ref": "#/definitions/JavaScriptDialogHandledAction"
        },
        "has_browser_handler": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "message": {
          "type": "string"
        },
        "sequence": {
          "description": "Monotonic per-tab sequence for ordering within a session.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "tab_id": {
          "type": "integer",
          "format": "int64"
        },
        "type": {
          "$ref": "#/definitions/JavaScriptDialogType"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "JavaScriptDialogType": {
      "description": "Native JS dialog kind reported by CDP.",
      "type": "string",
      "enum": [
        "alert",
        "confirm",
        "prompt",
        "beforeunload"
      ]
    },
    "Locator": {
      "description": "Unified element locator used by CLI, Flow, and extension interaction tools. Exactly one primary strategy must be present. `role` additionally requires `name`; `exact` applies to semantic string strategies only.",
      "type": "object",
      "properties": {
        "css": {
          "type": [
            "string",
            "null"
          ]
        },
        "exact": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "placeholder": {
          "type": [
            "string",
            "null"
          ]
        },
        "ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "type": [
            "string",
            "null"
          ]
        },
        "testId": {
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "SnapshotDeltaStatus": {
      "type": "string",
      "enum": [
        "available",
        "unchanged",
        "full_required",
        "delta_unavailable"
      ]
    }
  }
}
