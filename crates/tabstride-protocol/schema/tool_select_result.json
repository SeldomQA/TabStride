{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SelectResult",
  "type": "object",
  "required": [
    "multiple",
    "selected_labels",
    "selected_values",
    "tab_id",
    "used_target"
  ],
  "properties": {
    "dialogs": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/JavaScriptDialogInfo"
      }
    },
    "document_changed": {
      "description": "Whether the page DOM changed as a result of this interaction.",
      "default": false,
      "type": "boolean"
    },
    "document_version": {
      "description": "CDP document version after the interaction.",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0.0
    },
    "multiple": {
      "description": "Whether the target `<select>` had the `multiple` attribute.",
      "type": "boolean"
    },
    "selected_labels": {
      "description": "Visible labels of the selected options (same order as `selected_values`).",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "selected_values": {
      "description": "Final selected option `value` attributes after the call.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tab_id": {
      "type": "integer",
      "format": "int64"
    },
    "used_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "used_selector": {
      "type": [
        "string",
        "null"
      ]
    },
    "used_target": {
      "$ref": "#/definitions/Locator"
    }
  },
  "definitions": {
    "JavaScriptDialogHandledAction": {
      "description": "How the extension resolved the dialog so CDP could continue.",
      "type": "string",
      "enum": [
        "accepted",
        "dismissed"
      ]
    },
    "JavaScriptDialogInfo": {
      "description": "One observed + handled JavaScript dialog during a tool call.",
      "type": "object",
      "required": [
        "handled",
        "message",
        "sequence",
        "tab_id",
        "type"
      ],
      "properties": {
        "default_prompt": {
          "type": [
            "string",
            "null"
          ]
        },
        "handled": {
          "$ref": "#/definitions/JavaScriptDialogHandledAction"
        },
        "has_browser_handler": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "message": {
          "type": "string"
        },
        "sequence": {
          "description": "Monotonic per-tab sequence for ordering within a session.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "tab_id": {
          "type": "integer",
          "format": "int64"
        },
        "type": {
          "$ref": "#/definitions/JavaScriptDialogType"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "JavaScriptDialogType": {
      "description": "Native JS dialog kind reported by CDP.",
      "type": "string",
      "enum": [
        "alert",
        "confirm",
        "prompt",
        "beforeunload"
      ]
    },
    "Locator": {
      "description": "Unified element locator used by CLI, Flow, and extension interaction tools. Exactly one primary strategy must be present. `role` additionally requires `name`; `exact` applies to semantic string strategies only.",
      "type": "object",
      "properties": {
        "css": {
          "type": [
            "string",
            "null"
          ]
        },
        "exact": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "placeholder": {
          "type": [
            "string",
            "null"
          ]
        },
        "ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "type": [
            "string",
            "null"
          ]
        },
        "testId": {
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
