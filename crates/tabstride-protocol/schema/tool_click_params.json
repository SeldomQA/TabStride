{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ClickParams",
  "type": "object",
  "required": [
    "session_id",
    "target"
  ],
  "properties": {
    "button": {
      "anyOf": [
        {
          "$ref": "#/definitions/MouseButton"
        },
        {
          "type": "null"
        }
      ]
    },
    "click_count": {
      "description": "Number of consecutive mouse presses (double-click = 2).",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 1.0
    },
    "modifiers": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/definitions/KeyModifier"
      }
    },
    "session_id": {
      "type": "string"
    },
    "tab_id": {
      "description": "Target tab. Defaults to the Agent Window's active tab.",
      "type": [
        "integer",
        "null"
      ],
      "format": "int64"
    },
    "target": {
      "$ref": "#/definitions/Locator"
    },
    "timeout_ms": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 1.0
    }
  },
  "definitions": {
    "KeyModifier": {
      "description": "Keyboard modifier flags. Multiple flags may be combined; the extension folds them into CDP's bitfield (`alt=1, ctrl=2, meta=4, shift=8`).",
      "type": "string",
      "enum": [
        "alt",
        "ctrl",
        "meta",
        "shift"
      ]
    },
    "Locator": {
      "description": "Unified element locator used by CLI, Flow, and extension interaction tools. Exactly one primary strategy must be present. `role` additionally requires `name`; `exact` applies to semantic string strategies only.",
      "type": "object",
      "properties": {
        "css": {
          "type": [
            "string",
            "null"
          ]
        },
        "exact": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "placeholder": {
          "type": [
            "string",
            "null"
          ]
        },
        "ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "type": [
            "string",
            "null"
          ]
        },
        "testId": {
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "MouseButton": {
      "description": "Mouse button selector for `tool.click`.",
      "type": "string",
      "enum": [
        "left",
        "middle",
        "right"
      ]
    }
  }
}
